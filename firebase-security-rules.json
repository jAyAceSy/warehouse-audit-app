{
  "rules": {
    "warehouseAuditData": {

      "meta": {
        "bootstrapped": {
          ".read": true,
          ".write": "!root.child('warehouseAuditData/userRoles').exists() || (auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin')"
        }
      },

      "userRoles": {
        ".read": "auth != null",
        "$uid": {
          ".write": "(!root.child('warehouseAuditData/userRoles').exists() && auth != null && auth.uid === $uid) || (auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin')",
          "lastSeen": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      },

      "sites": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin'"
      },

      "areasBySite": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin'"
      },

      "findings": {
        "$siteId": {
          ".read": "auth != null && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)",
          ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)"
        }
      },

      "checklistsByArea": {
        "$siteId": {
          ".read": "auth != null && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)",
          ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)"
        }
      },

      "reports": {
        "$siteId": {
          ".read": "auth != null && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)",
          ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)"
        }
      },

      "areaLastSubmitted": {
        "$siteId": {
          ".read": "auth != null && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)",
          ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)"
        }
      },

      "auditSessions": {
        "$siteId": {
          ".read": "auth != null && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)",
          ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)"
        }
      },

      "titleTemplatesBySite": {
        "$siteId": {
          ".read": "auth != null && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)",
          ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin'"
        }
      },

      "staffByArea": {
        "$siteId": {
          ".read": "auth != null && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)",
          ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)"
        }
      },

      "pendingStaff": {
        "$siteId": {
          ".read": "auth != null && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)",
          ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)"
        }
      },

      "activityLog": {
        "$siteId": {
          ".read": "auth != null && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)",
          ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('sites').child($siteId).val() === true)"
        }
      },

      "adminActivityLog": {
        ".read": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true"
      },

      "archive": {
        "findings": {
          "$siteId": {
            ".read": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin'",
            ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin'"
          }
        },
        "reports": {
          "$siteId": {
            ".read": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin'",
            ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin'"
          }
        }
      },

      "users": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
