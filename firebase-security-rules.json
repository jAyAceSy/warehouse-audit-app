{
  "rules": {
    "warehouseAuditData": {

      ".read": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true",

      "meta": {
        "bootstrapped": {
          ".read": true,
          ".write": "!root.child('warehouseAuditData/userRoles').exists() || (auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin')"
        }
      },

      "userRoles": {
        ".read": "auth != null",
        "$uid": {
          ".write": "(!root.child('warehouseAuditData/userRoles').exists() && auth != null && auth.uid === $uid) || (auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin')",
          "lastSeen": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      },

      "findings": {
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() !== null"
      },

      "checklistsByFloor": {
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'auditor')"
      },

      "reports": {
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'auditor')"
      },

      "floorLastSubmitted": {
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true && (root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin' || root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'auditor')"
      },

      "archive": {
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin'"
      },

      "activityLog": {
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true"
      },

      "titleTemplates": {
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin'"
      },

      "staffByFloor": {
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('role').val() === 'admin'"
      },

      "pendingStaff": {
        ".write": "auth != null && root.child('warehouseAuditData/userRoles').child(auth.uid).child('active').val() === true"
      },

      "users": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
